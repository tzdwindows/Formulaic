<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Formulaic</id>
    <version>1.2.0</version>
    <title>Formulaic</title>
    <authors>tzdwindows</authors>
    <owners>tzdwindows</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/tzdwindows/Formulaic</projectUrl>
    <repository type="git" url="https://github.com/tzdwindows/Formulaic.git" />
    <readme>docs\README.md</readme>
    <description>Modern C++20 high-performance mathematical function expression parser, numerical calculus &amp; FFT engine, standard bidirectional LaTeXLive converter &amp; vector rendering module, and raster visualization library. Features zero-heap VM execution, implicit equation contour extraction (LHS = RHS), parametric curves, 2D scalar fields, Win32 double-buffered HWND rendering, syntax highlighting &amp; autocomplete editor, portable GMP/mini-gmp multi-precision evaluation, and extensible pipeline hooks.</description>
    <summary>Modern C++20 High Performance Mathematical Parser, Numerical Calculus, FFT, Bidirectional LaTeXLive Engine and Real-Time Visual Rendering Engine</summary>
    <releaseNotes>v1.2.0: Major feature release: Interactive 3D surface preview (Sombrero/sinc wave, Painter's depth sorting, dual-sided diffuse lighting, Viridis colormap shading, mouse drag rotation and wheel zoom), standard LaTeXLive bidirectional converter (to_latex and to_script), vector LaTeX visual math rendering module with dynamic DelimitedBox scaling and high-resolution PNG export, multi-precision GMP/mini-gmp arithmetic integration, asymptotic pole elimination, and real-time interactive LaTeXLive HUD in test_editor_window.</releaseNotes>
    <copyright>Copyright (c) 2026 tzdwindows</copyright>
    <tags>native nativepackage cpp cpp20 math expression-parser latex latexlive calculus fft rendering marching-squares visualization win32 gmp</tags>
  </metadata>
  <files>
    <file src="nuget\build\**" target="build" />
    <file src="nuget\tools\**" target="tools" />
    <file src="README.md" target="docs\README.md" />
  </files>
</package>
